  "dialog": "<c-dialog.trigger dialog-for=\"account\" native>Edit account</c-dialog.trigger>\n<c-dialog id=\"account\" title=\"Edit account\" description=\"Update your information.\">\n  <p>{{ user.email }}</p>\n  <c-dialog.close commandfor=\"account\">Done</c-dialog.close>\n</c-dialog>",
