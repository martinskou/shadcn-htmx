{
  "accordion": "<c-accordion>\n  <c-accordion.item value=\"shipping\">\n    <c-accordion.trigger>Shipping</c-accordion.trigger>\n    <c-accordion.content>Ships within two working days.</c-accordion.content>\n  </c-accordion.item>\n</c-accordion>",
  "active-search": "<c-active-search id=\"search\" name=\"q\" action=\"/search/\" hx-target=\"#results\" aria-label=\"Search\" />\n<div id=\"results\"></div>",
