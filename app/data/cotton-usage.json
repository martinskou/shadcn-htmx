  "badge": "<c-badge variant=\"secondary\">Published</c-badge>",
  "breadcrumb": "<c-breadcrumb><c-breadcrumb.list>\n  <c-breadcrumb.item><c-breadcrumb.link href=\"/\">Home</c-breadcrumb.link></c-breadcrumb.item>\n  <c-breadcrumb.separator />\n  <c-breadcrumb.item><c-breadcrumb.page>Settings</c-breadcrumb.page></c-breadcrumb.item>\n</c-breadcrumb.list></c-breadcrumb>",
  "button": "<c-button type=\"submit\">Save</c-button>\n<c-button variant=\"outline\" hx-post=\"/save/\" hx-target=\"#result\">Save with htmx</c-button>\n<c-button variant=\"destructive\" :disabled=\"is_locked\">Delete</c-button>",
  "card": "<c-card>\n  <c-card.header>\n    <c-card.title as=\"h2\">Account</c-card.title>\n    <c-card.description>Update your account settings.</c-card.description>\n  </c-card.header>\n  <c-card.content>{{ user.email }}</c-card.content>\n  <c-card.footer>Last updated today</c-card.footer>\n</c-card>",
  "carousel": "<c-carousel id=\"photos\" aria-label=\"Featured images\"><c-carousel.content>\n  <c-carousel.item><img src=\"/static/first.jpg\" alt=\"Forest\" /></c-carousel.item>\n  <c-carousel.item><img src=\"/static/second.jpg\" alt=\"Coast\" /></c-carousel.item>\n</c-carousel.content><c-carousel.previous /><c-carousel.next /></c-carousel>",
  "cascading-select": "<c-cascading-select id=\"location\" endpoint=\"/cities/\" parent-label=\"Country\" child-label=\"City\">\n  <option value=\"dk\">Denmark</option>\n  <c-slot name=\"child_body\"><option value=\"copenhagen\">Copenhagen</option></c-slot>\n</c-cascading-select>",
  "checkbox": "<c-checkbox id=\"terms\" name=\"terms\" required />\n<label for=\"terms\">Accept the terms</label>",
  "collapsible": "<c-collapsible><c-collapsible.trigger>Details</c-collapsible.trigger><c-collapsible.content>More information.</c-collapsible.content></c-collapsible>",
